# XDG autostart in a Solium session (#146): the programs in ~/.config/autostart
# and /etc/xdg/autostart.
#
# Solium starts this after solium-session.target while `session.autostart` is
# on, and it stops with that target
# (`session::tests::session_autostart_false_starts_the_session_without_autostart`,
# dev/install-check.sh). A unit of its own, so that turning autostart off leaves
# what is attached to solium-session.target starting. dev/install.sh puts it in
# ~/.config/systemd/user, or, with a /usr or /usr/local prefix, in
# <prefix>/lib/systemd/user.
[Unit]
Description=XDG autostart in a Solium session
Documentation=man:systemd.special(7) https://github.com/Lilium-Linux/solium/blob/stage/docs/shell-boundary.md
PartOf=solium-session.target
After=solium-session.target
Wants=xdg-desktop-autostart.target
