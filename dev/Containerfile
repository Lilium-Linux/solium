# The build environment for Solium.
#
# Fedora, matching the host it was written for, and that is the entire point of
# the choice: build in an image of the distribution you run. A vendored C
# dependency (Lua) is compiled by whatever toolchain builds the project, so a
# container with a *newer* C library produces a binary the host cannot start.
# Worse, working around that by running the compositor inside the container
# costs hardware acceleration: the container has Mesa but no GPU driver, so
# everything falls back to llvmpipe and renders at ~55 fps.
#
# Matching the host means the binary runs on the host, on the real driver.
#
#   podman build -t solium-build:fc44 -f dev/Containerfile dev/
ARG FEDORA_VERSION=44
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}

RUN dnf install -y --setopt=install_weak_deps=False \
        gcc gcc-c++ make pkgconf-pkg-config \
        wayland-devel libinput-devel systemd-devel libseat-devel \
        libxkbcommon-devel mesa-libgbm-devel mesa-libEGL-devel \
        libdrm-devel \
        qt6-qtbase-devel qt6-qtdeclarative-devel \
        foot \
    && dnf clean all

# No Rust in the image. It comes from the user's own rustup install: dev/gate.sh
# mounts CARGO_HOME and RUSTUP_HOME at the same paths and puts CARGO_HOME/bin on
# PATH, so the container builds with exactly the toolchain the host has.
