#!/usr/bin/env bash
#
# Build the animation preview: mock windows animated by the engine itself.
#
# Two steps, because the page embeds the engines. The animation curves and the
# window arrangements are both compiled to WebAssembly and called from the page,
# so what you tune in a browser is the code that moves and arranges real
# windows — a copy in JavaScript would drift the first time either side changed,
# invisibly.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="$root/crates/animation/preview/preview.html"

cargo build -p solium-animation -p solium-layout --target wasm32-unknown-unknown --release
cargo run -q -p solium-animation --bin preview -- \
    "$root/target/wasm32-unknown-unknown/release/solium_animation.wasm" \
    "$root/target/wasm32-unknown-unknown/release/solium_layout.wasm" > "$out"

echo "wrote $out"
echo "open it with: xdg-open $out"
