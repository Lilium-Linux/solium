/// What crosses the socket: one `message` per frame.
///
/// The compositor sends a `batch` of what changed and what happened; the
/// window manager answers it with an `answer` naming the same serial, each
/// batch once, in the order they came. The compositor waits for an answer
/// for one frame (the setting `wm.ask-ms`), and then goes on without it: a
/// bound key is not typed into the window under it, a new window is placed
/// plainly, a notification is shown. The answer is applied when it comes.
/// While an answer is owed, no later batch is waited for at all. The window
/// manager may also `submit` commands of its own whenever it likes.
interface messages {
    use types.{rect, window, monitor, keyboard, text-field, problem, touch-event, doc, style};
    use commands.{command, focus-cause, motion};

    /// The first message, from the compositor: the protocol it speaks,
    /// whether the session runs in debug mode (`solium --debug-mode`), where
    /// a window manager may offer what only belongs in a development
    /// session, and everything the window manager kept before it was
    /// restarted.
    record hello {
        /// The protocol's version, as `major.minor.patch`. A window manager
        /// built for another major version, or before 1.0 another minor
        /// one, says `goodbye`.
        version: string,
        /// Whether the session runs in debug mode.
        debug: bool,
        /// What the window manager this one takes the place of kept, by
        /// name, as its `keep` commands last said: nothing for the first
        /// of a session.
        keeps: list<tuple<string, doc>>,
    }

    /// The window manager's reply to `hello`: the protocol it was built
    /// for, and the commands that configure the desktop before its first
    /// frame (settings, bindings, the events it listens to).
    record hello-answer {
        /// The protocol's version the window manager was built for.
        version: string,
        /// Applied before the first frame is drawn.
        commands: list<command>,
    }

    /// What changed since the last batch. A window or monitor is sent whole
    /// when any of it changed; the window manager keeps the latest of each.
    variant change {
        /// A window that is new, or one any field of which changed.
        window(window),
        /// A window that is no more, by its id.
        window-gone(u64),
        /// The windows, top to bottom, when their order changed.
        stacking(list<u64>),
        /// Every monitor, when one came, went or changed.
        monitors(list<monitor>),
        /// The part of the monitor the pointer is on that bars and docks
        /// leave.
        work-area(rect),
        /// Where the pointer is.
        cursor(tuple<f64, f64>),
        /// The keyboard: its layouts, the live one, the locks.
        keyboard(keyboard),
        /// The window holding the compositor's shortcuts, as a virtual
        /// machine or a remote desktop does; none when the bindings have
        /// them.
        shortcuts-owner(option<u64>),
        /// The text field that has the keyboard; none when none has.
        text-field(option<text-field>),
        /// Every problem there is now.
        problems(list<problem>),
        /// Whether the session is locked.
        locked(bool),
        /// A view of a session service, or of the installed applications:
        /// `notifications`, `audio`, `tray`, `media` and `apps`, each a
        /// document of the rows the service has.
        service(tuple<string, doc>),
    }


    /// A program's output, a line at a time, and how it ended.
    variant run-heard {
        /// A line it wrote to its standard output: the run's id and the
        /// line, without its newline.
        stdout(tuple<u64, list<u8>>),
        /// A line it wrote to its standard error.
        stderr(tuple<u64, list<u8>>),
        /// It ended.
        done(run-ended),
    }

    /// How a program run with `run` ended.
    record run-ended {
        /// The run's id, as the `run` command gave it.
        id: u64,
        /// Its exit code, when it exited.
        code: option<s32>,
        /// The signal that ended it, when one did.
        signal: option<s32>,
        /// Whether it was stopped for running past its timeout.
        timed-out: bool,
        /// Whether it wrote more than was kept.
        truncated: bool,
        /// What it wrote to its standard output, up to the run's limit.
        stdout: list<u8>,
        /// What it wrote to its standard error, up to the run's limit.
        stderr: list<u8>,
        /// Why the program could not be run at all.
        error: option<string>,
    }

    /// What a file read, write or watch came to.
    variant file-heard {
        /// A `file-read` finished: its id, and the file's bytes or why it
        /// could not be read.
        read(tuple<u64, result-bytes>),
        /// A `file-write` that asked for a report finished: its id, and why
        /// it failed, if it did.
        wrote(tuple<u64, option<string>>),
        /// A watched file changed: the watch's id, what happened, and the
        /// path as the `watch` command wrote it.
        watched(tuple<u64, file-change, string>),
        /// A watch ended on its own: its directory is gone.
        watch-ended(u64),
    }

    /// Bytes, or why there are none.
    variant result-bytes { ok(list<u8>), error(string) }

    /// What happened to a watched file.
    enum file-change { changed, created, removed }

    /// What became of an action sent with `act`.
    record settled {
        /// The attempt's id, as the `act` command gave it.
        attempt: u64,
        /// Whether it was done.
        ok: bool,
        /// Why not, when it was not.
        reason: option<string>,
    }

    /// Something that happened, in the order it happened. A window manager
    /// is sent the ones it named in its `listen` command, and a few that
    /// need no listening, which that command lists.
    variant event {
        /// The window manager has been started, or started again, and what
        /// it asked for in `hello-answer` is applied: the desktop's first
        /// moment. Sent without being listened to.
        startup,
        /// A key combination the window manager bound was pressed, named
        /// as it wrote it in its `binding`. Sent without being listened
        /// to. An answer that is `handled` keeps the key from the window
        /// under it.
        key(string),
        /// A window's life began. An answer that is `handled` and places
        /// it is where it opens; otherwise the compositor places it
        /// plainly, centred and cascaded.
        opened(u64),
        /// A window went fullscreen, or left it: its id, and whether it is
        /// entering. Told once the change is made. The answer's `motion`
        /// is how its picture moves there.
        fullscreen(tuple<u64, bool>),
        /// A window was maximised, or restored: its id, and whether it is
        /// entering. Told and answered as `fullscreen` is.
        maximize(tuple<u64, bool>),
        /// A pointer or finger press at this point while the window
        /// manager holds input (`grab`).
        click(tuple<f64, f64>),
        /// A finger did something. Its down is told before it is delivered,
        /// so the answer can take it with the `touch` command.
        touch(touch-event),
        /// The keyboard moved to a window: its id, what moved it, and
        /// whether it came from another window or none.
        focused(tuple<u64, focus-cause, bool>),
        /// The live keyboard layout, Caps Lock or Num Lock changed: which,
        /// as `layout`, `caps` or `num`.
        keyboard-changed(string),
        /// The session's lock changed: `locking`, `locked`, `unlocking` or
        /// `unlocked`.
        lock-changed(string),
        /// The focused text field changed: `field` when one took the
        /// keyboard, `caret` when its caret moved, `framed` when its
        /// window started or stopped being drawn in a frame.
        text-input(string),
        /// A window asked to be brought forward: its id, and why, `launch`
        /// when an application already running answered a launch with a
        /// window it had, `request` for anything else.
        activated(tuple<u64, string>),
        /// An edge of a window is being dragged by the window's own
        /// resize. An answer that is `handled` moves a seam of a layout;
        /// otherwise the compositor resizes the window itself.
        resized(resized),
        /// The window is gone.
        closed(u64),
        /// A close was asked for and the window is going.
        closing(u64),
        /// A close the compositor asked for has played out, and the
        /// window's application has just been asked to go.
        close-landed(u64),
        /// A window's application declined to close, and the window is
        /// back.
        refused(u64),
        /// A notification arrived or was replaced, as JSON text. The
        /// answer's `decision` says what becomes of it; with none, it is
        /// shown and kept as the sender asked.
        notification(string),
        /// Something happened to a notification, as JSON text.
        notifications(string),
        /// Something changed in audio, as JSON text.
        audio(string),
        /// Something changed in the tray, as JSON text.
        tray(string),
        /// Something changed in media, as JSON text.
        media(string),
        /// Notifications the window manager sent with `notify` are gone,
        /// by their tokens: nothing more is heard of them. Sent without
        /// being listened to.
        notify-forget(list<u64>),
        /// An action of a notification the window manager sent with
        /// `notify` was chosen: its token, and the action's key. Sent
        /// without being listened to.
        notify-action(tuple<u64, string>),
        /// A window was minimized.
        minimized(u64),
        /// A minimized window is shown again.
        unminimized(u64),
        /// The monitors came, went or changed size, or were announced at
        /// startup or after a reload.
        monitors-changed,
        /// The problems changed: something broke, or a reload mended it.
        problems-changed,
        /// This window manager took the place of one that was running:
        /// after a reload or a restart, never at the start of a session.
        restored,
        /// A window's frame sent an action: the window's id, the action's
        /// name, and its data as JSON text.
        frame-action(tuple<u64, string, string>),
        /// A scene sent an action: the surface's name, the action's name,
        /// and its data as JSON text.
        surface-action(tuple<string, string, string>),
        /// What became of actions the window manager sent with `act`.
        /// Sent without being listened to.
        attempts-settled(list<settled>),
        /// What programs the window manager ran with `run` wrote, and how
        /// they ended. Sent without being listened to.
        runs(list<run-heard>),
        /// Timers the window manager set with `timer` fell due: each one's
        /// id, and whether it was its last time. Sent without being
        /// listened to.
        timers(list<tuple<u64, bool>>),
        /// What the window manager's `file-read`, `file-write` and `watch`
        /// commands came to. Sent without being listened to.
        files(list<file-heard>),
        /// The windows the window manager arranges are to be arranged
        /// again: something they stand in changed.
        relayout,
        /// A window is being moved by the pointer or a finger.
        dragged(pointer-move),
        /// A window's resize by the pointer or a finger began or ended.
        resizing(pointer-move),
        /// A dragged window was let go: its id, and where.
        dropped(tuple<u64, f64, f64>),
        /// The wheel turned with the drag modifier held: by how much, on
        /// each axis. An answer that is `handled` keeps it from the window
        /// under the pointer.
        scrolled(tuple<f64, f64>),
        /// It is time to save: answered with a `store` for each store that
        /// changed since the last, and a `keep` for each kept document
        /// that did.
        save-stores,
    }

    /// A window's edge moved by its own resize.
    record resized {
        /// The window.
        id: u64,
        /// Where the dragged edge, or corner, now is.
        x: f64,
        y: f64,
        /// Which vertical edge is dragged: `left` or `right`, if either.
        horizontal: option<string>,
        /// Which horizontal edge is dragged: `top` or `bottom`, if either.
        vertical: option<string>,
    }

    /// A window being dragged or resized by the pointer.
    record pointer-move {
        /// The window.
        id: u64,
        /// `begin`, `move` or `end`.
        phase: string,
        /// Where the pointer is.
        x: f64,
        y: f64,
    }

    /// What the compositor tells the window manager at one moment: what
    /// changed since the last batch, then what happened.
    record batch {
        /// Which batch this is: its answer names it.
        serial: u64,
        /// Applied to the window manager's picture of the desktop before
        /// the events are handled.
        changes: list<change>,
        events: list<event>,
    }

    /// What the window manager made of a batch.
    record answer {
        /// The batch this answers.
        serial: u64,
        /// Whether it took the batch's key, press or scroll; one it did not
        /// take goes to the client.
        handled: bool,
        /// Applied in order, all at once.
        commands: list<command>,
        /// The motion the compositor's own move answering the batch takes,
        /// a fullscreen's or a maximise's, when the window manager set one.
        motion: option<motion>,
        /// A notification's fate, as JSON text, when the batch asked for
        /// one: an object with `banner` and `keep`, each a boolean, each
        /// left out taking the compositor's own rule.
        decision: option<string>,
    }

    /// What a window manager made of a reload: the answer its configuration
    /// gave as it loaded again, carrying what it kept, as `hello-answer`'s
    /// commands are; or why it would not load, in which case the
    /// configuration that was running goes on running.
    variant reloaded {
        /// It loaded. The answer's commands are applied as
        /// `hello-answer`'s are, and must say again what the window
        /// manager declares and listens to: what it said before the
        /// reload is forgotten.
        loaded(answer),
        /// It did not, and why. Nothing changes.
        failed(string),
    }

    /// A question only the compositor can answer, asked by a window
    /// manager in the middle of a batch, and answered before anything else.
    variant query {
        /// The topmost window drawn at a point, as the pointer finds it,
        /// passing over the one named.
        window-at(tuple<f64, f64, option<u64>>),
        /// A store's saved document, read from its file, at most the bytes
        /// given. The compositor keeps the files: one that cannot be used
        /// is set aside as `<name>.json.broken`, and none is the answer.
        store(tuple<string, u64>),
        /// Every window frame style there is, from the folders the
        /// compositor looks in: sorted, bundles first, each name once, as
        /// the compositor would resolve it.
        styles,
    }

    /// The answer to a `query`, case for case.
    variant reply {
        /// The window at the point, if one is drawn there.
        window(option<u64>),
        /// The store's document as JSON text, or none.
        store(option<string>),
        /// The frame styles.
        styles(list<style>),
    }

    /// One frame on the socket.
    variant message {
        /// From the compositor, first.
        hello(hello),
        /// From the window manager, in answer to `hello`.
        hello-answer(hello-answer),
        /// From the compositor: what changed and what happened.
        batch(batch),
        /// From the window manager: what it made of a batch.
        answer(answer),
        /// From the window manager, at any time: commands of its own,
        /// asked for by no batch, applied in the order they come.
        submit(list<command>),
        /// From the window manager: a question, and its serial.
        query(tuple<u64, query>),
        /// From the compositor: the answer to the query of that serial.
        reply(tuple<u64, reply>),
        /// From the compositor: the configuration at this path is to be
        /// loaded again (the user asked for a reload, or it changed on
        /// disk). Answered with `reloaded`.
        reload(string),
        /// From the window manager, in answer to `reload`.
        reloaded(reloaded),
        /// Either side is closing the connection, and says why. A window
        /// manager whose configuration would not load says why here, in
        /// place of `hello-answer`.
        goodbye(string),
    }
}
